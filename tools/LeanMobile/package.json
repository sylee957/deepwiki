{
  "name": "deepwiki-lean-mobile",
  "version": "0.2.0",
  "private": true,
  "module": "src/server.ts",
  "scripts": {
    "build": "bun build frontend/app.tsx --outfile dist/app.js --target browser --minify",
    "start": "bun run build && bun src/server.ts",
    "dev": "bun run build && bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2"
  }
}
