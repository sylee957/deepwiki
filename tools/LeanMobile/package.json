{
  "name": "deepwiki-lean-mobile",
  "version": "0.2.0",
  "private": true,
  "module": "src/server.ts",
  "scripts": {
    "build": "bun build frontend/app.tsx --outfile dist/app.js --target browser --minify",
    "start": "bun run build && bun src/server.ts",
    "dev": "bun run build && bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "codemirror": "^6.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2"
  }
}
