# Lean / Lake build artifacts
/.lake/
/build/
/lake-packages/

# Rendered output (doc-gen4 writes under /.lake/; the Verso tutorial writes
# /_out/; CI assembles the published Pages tree in /_site/)
/_out/
/_site/

# Editor
.DS_Store
/.vscode/

# Source-book PDFs for autoformalization (local only, readable by Claude)
/references/
.wiki/

# `tlts` CLI default model database (local timed-automata models)
.tlts/

# Never track PDFs anywhere (papers belong in the gitignored /references/)
*.pdf

# Local git worktrees (agent isolation scratch)
.claude/worktrees/

# Harness scheduled-task lock (local state, churns constantly)
.claude/scheduled_tasks.lock
