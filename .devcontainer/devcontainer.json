{
  "name": "Lean 4 + Mathlib",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "leanprover.lean4",
        "anthropic.claude-code"
      ],
      "settings": {
        "lean4.toolchainPath": "/home/vscode/.elan"
      }
    }
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.elan/bin:${containerEnv:PATH}"
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached"
  ],
  "hostRequirements": {
    "cpus": 4,
    "memory": "6gb"
  },
  "postCreateCommand": "elan toolchain install $(cat lean-toolchain) && lake exe cache get && lake build"
}
