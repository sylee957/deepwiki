{
  "name": "verso-preview",
  "displayName": "Verso Preview",
  "description": "Live, theme-matched preview of Verso (Lean 4 book) documents with LSP-backed hovers and go-to-definition.",
  "version": "0.2.0",
  "publisher": "deepwiki-local",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Verso Preview",
      "properties": {
        "versoPreview.colors.keyword": {
          "type": "string",
          "default": "#569CD6",
          "description": "Code color: keywords (def, theorem, fun, by, …)."
        },
        "versoPreview.colors.function": {
          "type": "string",
          "default": "#DCDCAA",
          "description": "Code color: function / declaration names."
        },
        "versoPreview.colors.type": {
          "type": "string",
          "default": "#4EC9B0",
          "description": "Code color: types."
        },
        "versoPreview.colors.namespace": {
          "type": "string",
          "default": "#4EC9B0",
          "description": "Code color: namespaces."
        },
        "versoPreview.colors.variable": {
          "type": "string",
          "default": "#9CDCFE",
          "description": "Code color: variables."
        },
        "versoPreview.colors.property": {
          "type": "string",
          "default": "#9CDCFE",
          "description": "Code color: properties / fields."
        },
        "versoPreview.colors.operator": {
          "type": "string",
          "default": "#D4D4D4",
          "description": "Code color: operators and punctuation."
        },
        "versoPreview.colors.string": {
          "type": "string",
          "default": "#CE9178",
          "description": "Code color: string literals."
        },
        "versoPreview.colors.number": {
          "type": "string",
          "default": "#B5CEA8",
          "description": "Code color: numeric literals."
        },
        "versoPreview.colors.comment": {
          "type": "string",
          "default": "#6A9955",
          "description": "Code color: comments."
        },
        "versoPreview.colors.sorryLike": {
          "type": "string",
          "default": "#F44747",
          "description": "Code color: sorry / admit / stop."
        }
      }
    },
    "commands": [
      {
        "command": "versoPreview.show",
        "title": "Open Preview to the Side",
        "category": "Verso",
        "icon": "$(open-preview)"
      },
      {
        "command": "versoPreview.back",
        "title": "Back",
        "category": "Verso",
        "icon": "$(arrow-left)"
      },
      {
        "command": "versoPreview.forward",
        "title": "Forward",
        "category": "Verso",
        "icon": "$(arrow-right)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "versoPreview.show",
          "when": "resourceExtname == .lean",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "versoPreview.show",
          "when": "resourceExtname == .lean"
        }
      ]
    },
    "keybindings": [
      {
        "command": "versoPreview.show",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceExtname == .lean"
      },
      {
        "command": "versoPreview.back",
        "key": "alt+left",
        "when": "activeWebviewPanelId == versoPreview"
      },
      {
        "command": "versoPreview.forward",
        "key": "alt+right",
        "when": "activeWebviewPanelId == versoPreview"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.webview.json",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "marked": "^18.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
